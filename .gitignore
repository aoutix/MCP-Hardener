# Dependencies and build output
node_modules/
dist/
dist-ui/
*.tsbuildinfo
coverage/

# Secrets. `.env.example` is the documented template and is meant to be
# committed, so it is exempted — everything else matching is not.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets.json
credentials.json

# Local runtime state. The console and the gateway keep their registry,
# approvals and audit trail in ~/.hmcp, but a policy pointed into the tree
# would put the same things here, and the audit log in particular is a record
# of real calls.
*.jsonl
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.hmcp/

# `hmcp-gateway adopt` keeps the entries it replaced so `--revert` can put them
# back. They are copied verbatim, so one that held a literal credential rather
# than a `${VAR}` means these files hold it too.
.hmcp-adopt-backup.json
*.hmcp-backup

# `npm run demo` state: a gateway config, a registry, an approvals database and
# an audit log, all rebuilt from the examples on demand. Disposable by design —
# the demo keeps it here precisely so it never writes into ~/.hmcp.
/.demo/

# Scratch
/tmp/
*.log

# Editor and OS
.DS_Store
.vscode/
.idea/
*.swp
