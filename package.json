{
  "name": "hardened-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc --build && npm run -w @hmcp/web build:ui",
    "demo": "node scripts/demo.mjs",
    "clean": "tsc --build --clean && rm -rf packages/web/dist-ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build && npm run -w @hmcp/web typecheck:ui",
    "build:server": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
